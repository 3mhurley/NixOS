# WireGuard override values — copy to /etc/wireguard/wg-variables.nix
# This file is loaded at build time when --impure is set.
{
  wgEnable = true;
  wgAutostart = false;        # true to start at boot, false for manual `wg-toggle`
  wgKillSwitch = false;       # true to block non-VPN egress
  wgBypassDomains = [ ];      # domains routed outside the tunnel
  wgAddress = "";             # [Interface] Address, e.g. "REDACTED_ADDR"
  wgServerPublicKey = "";     # [Peer] PublicKey
  wgServerEndpoint = "";      # [Peer] Endpoint, e.g. "1.2.3.4:51820"
  wgPresharedKeyFile = "";    # optional [Peer] PresharedKey file path
}
